rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profileExists(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid));
    }

    function profileDoc(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid));
    }

    function isAdmin() {
      return signedIn()
        && profileExists(request.auth.uid)
        && profileDoc(request.auth.uid).data.isAdmin == true;
    }

    function submissionDisplayNameAllowed(uid) {
      return (profileExists(uid)
        && request.resource.data.displayName == profileDoc(uid).data.displayName)
        || request.resource.data.displayName == request.auth.token.name
        || request.resource.data.displayName == request.auth.token.email;
    }

    function submissionUsernameAllowed(uid) {
      return profileExists(uid)
        && request.resource.data.username == profileDoc(uid).data.username;
    }

    function submissionExists(id) {
      return exists(/databases/$(database)/documents/submissions/$(id));
    }

    function submissionData(id) {
      return get(/databases/$(database)/documents/submissions/$(id)).data;
    }

    function canReadSubmission(id) {
      return submissionExists(id)
        && (submissionData(id).status == 'published'
          || !('status' in submissionData(id))
          || isAdmin()
          || isOwner(submissionData(id).uid));
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function isReportReason(reason) {
      return reason in ['spam', 'abuse', 'plagiarism', 'inaccurate', 'other'];
    }

    function isReportStatus(status) {
      return status in ['open', 'reviewed', 'dismissed'];
    }

    function reportKeys() {
      return [
        'submissionId',
        'submissionType',
        'submissionTitle',
        'submissionAuthorUid',
        'submissionAuthorUsername',
        'reporterUid',
        'reporterUsername',
        'reason',
        'details',
        'status',
        'createdAt',
        'reviewedAt',
        'reviewedBy',
      ];
    }

    function hasOnlyReportKeys(data) {
      return data.keys().hasOnly(reportKeys()) && data.keys().hasAll(reportKeys());
    }

    function reportReasonLengthOk(reason) {
      return reason is string && reason.size() <= 32;
    }

    function reportDetailsLengthOk(details) {
      return details == null || (details is string && details.size() <= 2000);
    }

    // ---------- PROFILES ----------
    match /profiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && (!('username' in request.resource.data) || request.resource.data.username == null)
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      // Username is claimed via Cloud Function (admin) and is locked here.
      allow update: if isOwner(uid)
        && request.resource.data.username == resource.data.username
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.submissionCount == resource.data.submissionCount;
      allow delete: if false;
    }

    // ---------- PRIVATE USERS ----------
    match /privateUsers/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /privateUsers/{uid}/favorites/{favoriteId} {
      allow read, create, update, delete: if isOwner(uid);
    }

    // ---------- USERNAMES REGISTRY ----------
    match /usernames/{name} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- SUBMISSIONS ----------
    match /submissions/{id} {
      allow read: if resource.data.status == 'published'
        || !('status' in resource.data)
        || isAdmin()
        || isOwner(resource.data.uid);
      allow create: if false;
      allow update: if (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.status == resource.data.status
        && (
          (!('statusChangedAt' in resource.data) && !('statusChangedAt' in request.resource.data))
          || request.resource.data.statusChangedAt == resource.data.statusChangedAt
        )
        && (
          (!('statusChangedBy' in resource.data) && !('statusChangedBy' in request.resource.data))
          || request.resource.data.statusChangedBy == resource.data.statusChangedBy
        )
        && (
          (!('statusReason' in resource.data) && !('statusReason' in request.resource.data))
          || request.resource.data.statusReason == resource.data.statusReason
        )
        && (
          (!('reportCount' in resource.data) && !('reportCount' in request.resource.data))
          || request.resource.data.reportCount == resource.data.reportCount
        )
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.voteUp == resource.data.voteUp
        && request.resource.data.voteDown == resource.data.voteDown
        && request.resource.data.voteScore == resource.data.voteScore
        && request.resource.data.updatedBy == request.auth.uid
        // Field length validation (max lengths from Cloud Functions)
        && (!('title' in request.resource.data) || request.resource.data.title == null || (request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120))
        && (request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 4000)
        && (request.resource.data.meaning is string && request.resource.data.meaning.size() >= 1 && request.resource.data.meaning.size() <= 2000)
        && (!('translation' in request.resource.data) || request.resource.data.translation == null || (request.resource.data.translation is string && request.resource.data.translation.size() <= 2000)))
        || isAdmin();
      allow delete: if isOwner(resource.data.uid) || isAdmin();

      match /comments/{commentId} {
        allow read: if canReadSubmission(id);
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.submissionId == id
          && profileExists(request.auth.uid)
          && submissionUsernameAllowed(request.auth.uid)
          && submissionDisplayNameAllowed(request.auth.uid)
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 2000;
        allow update: if false;
        allow delete: if isOwner(resource.data.uid) || isAdmin();
      }

      match /votes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
      }

      match /reports/{uid} {
        allow create: if signedIn()
          && uid == request.auth.uid
          && hasOnlyReportKeys(request.resource.data)
          && request.resource.data.reporterUid == request.auth.uid
          && request.resource.data.submissionId == id
          && request.resource.data.submissionType is string
          && request.resource.data.submissionType in ['Proverb', 'Poetry']
          && request.resource.data.submissionTitle is string
          && request.resource.data.submissionAuthorUid is string
          && isNullableString(request.resource.data.submissionAuthorUsername)
          && isNullableString(request.resource.data.reporterUsername)
          && request.resource.data.reason is string
          && isReportReason(request.resource.data.reason)
          && reportReasonLengthOk(request.resource.data.reason)
          && request.resource.data.status is string
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt is number
          && isNullableString(request.resource.data.details)
          && reportDetailsLengthOk(request.resource.data.details)
          && request.resource.data.reviewedAt == null
          && request.resource.data.reviewedBy == null
          && !exists(/databases/$(database)/documents/submissions/$(id)/reports/$(uid));
        allow read: if isAdmin() || isOwner(uid);
        allow update: if isAdmin()
          && hasOnlyReportKeys(request.resource.data)
          && request.resource.data.submissionId == id
          && request.resource.data.reporterUid == resource.data.reporterUid
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isAdmin();
      }
    }

    // ---------- DEFAULT DENY ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
